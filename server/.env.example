PORT=3002
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/showcase_db
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE=1d
NODE_ENV=development

# Image storage. Required in production (Vercel's disk is temporary).
# Copy "API environment variable" from the Cloudinary dashboard.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_FOLDER=labline

# Extra allowed origins for CORS (comma-separated). Vercel's own URLs are allowed automatically.
CLIENT_URL=

# First admin account. Only used when the database has no users at all.
INITIAL_ADMIN_NAME=Admin
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
